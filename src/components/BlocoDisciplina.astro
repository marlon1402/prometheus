---
// Bloco de uma disciplina na Home: fundo pastel, ilustração e situação.
// Vira link para o filtro da disciplina quando ela já tem lições publicadas.
import { emBreve, type Disciplina } from '../lib/catalogo';
import { biomasMini } from '../mapas/biomas';
import { url } from '../lib/url';

interface Props {
  disciplina: Disciplina;
  /** Blocos grandes ocupam metade da linha; os demais, um terço. */
  grande?: boolean;
}

const { disciplina, grande = false } = Astro.props;
const { nome, resumo, cor } = disciplina.data;
const breve = await emBreve(disciplina);
const Tag = breve ? 'div' : 'a';
// Geografia usa o mapa dos biomas em miniatura; as demais, desenhos num quadro de 200×140.
const viewBox = disciplina.id === 'geografia' ? biomasMini.viewBox : '0 0 200 140';
---

<Tag
  class:list={['bloco-disc', { grande }]}
  href={breve ? undefined : url(`conteudos/${disciplina.id}/`)}
  style={`--cor: var(--${cor}); --cor-ink: var(--${cor}-ink)`}
>
  <svg class="ilus" viewBox={viewBox} aria-hidden="true">
    {
      disciplina.id === 'fisica' && (
        <>
          <ellipse cx="100" cy="70" rx="86" ry="44" fill="none" stroke-width="2" stroke-dasharray="3 7" stroke-linecap="round" />
          <circle cx="100" cy="70" r="30" class="cheio" />
          <circle cx="183" cy="60" r="6" class="ponto" />
        </>
      )
    }
    {
      disciplina.id === 'geografia' &&
        Object.entries(biomasMini.regioes).map(([id, d]) => <path d={d} fill-rule="evenodd" class:list={['bioma', id.toLowerCase()]} />)
    }
    {
      disciplina.id === 'matematica' && (
        <>
          <path d="M20 120 H180 M40 130 V20" stroke-width="2" opacity=".4" />
          <path d="M40 118 Q 110 -40 180 118" fill="none" stroke-width="3" stroke-linecap="round" />
        </>
      )
    }
    {
      disciplina.id === 'quimica' && (
        <>
          <path d="M100 70 L60 40 M100 70 L145 45 M100 70 L100 115" stroke-width="3" />
          <circle cx="100" cy="70" r="20" class="cheio" />
          <circle cx="58" cy="38" r="12" class="ponto" />
          <circle cx="147" cy="43" r="12" class="ponto" />
          <circle cx="100" cy="117" r="12" class="ponto" />
        </>
      )
    }
    {
      disciplina.id === 'biologia' && (
        <>
          <ellipse cx="100" cy="70" rx="78" ry="50" fill="none" stroke-width="3" />
          <circle cx="112" cy="66" r="18" class="cheio" />
          <ellipse cx="62" cy="88" rx="12" ry="6" class="ponto" />
          <ellipse cx="150" cy="96" rx="9" ry="5" class="ponto" />
        </>
      )
    }
  </svg>
  <div>
    <h3>{nome}</h3>
    <p>{resumo}</p>
    <span class="status">{breve ? 'Em breve' : 'Disponível'}</span>
  </div>
</Tag>

<style>
  .bloco-disc {
    grid-column: span 2;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    min-height: 220px;
    padding: 28px;
    border-radius: 24px;
    overflow: hidden;
    background: var(--cor);
    color: var(--ink);
    text-decoration: none;
    transition:
      transform var(--medio) var(--curva),
      box-shadow var(--medio) var(--curva);
  }

  .grande {
    grid-column: span 3;
    min-height: 380px;
  }

  a.bloco-disc:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px -24px rgb(0 0 0 / 0.35);
  }

  a.bloco-disc:active {
    transform: translateY(-1px) scale(0.99);
  }

  /* A ilustração se move um pouco no hover */
  .ilus {
    transition: transform var(--lento) var(--curva);
  }

  a.bloco-disc:hover .ilus {
    transform: translateY(-6px) rotate(-3deg);
  }

  h3 {
    margin: 0 0 4px;
    font-weight: 500;
    font-size: 30px;
    letter-spacing: -0.01em;
  }

  p {
    margin: 0 0 14px;
    color: var(--muted);
    font-size: 18px;
  }

  .status {
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 500;
    color: var(--cor-ink);
  }

  .ilus {
    align-self: flex-end;
    width: 100%;
    max-width: 150px;
    height: auto;
    fill: none;
    stroke: var(--cor-ink);
  }

  .grande .ilus {
    max-width: 240px;
  }

  .cheio {
    fill: var(--cor-ink);
    stroke: none;
    opacity: 0.25;
  }

  /* Cores sólidas (sem transparência) e contorno da mesma cor: cobrem as frestas
     entre biomas vizinhos, que aparecem porque cada um foi simplificado separadamente. */
  .bioma {
    --tom: color-mix(in srgb, var(--cor-ink) 22%, var(--cor));
    fill: var(--tom);
    stroke: var(--tom);
    stroke-width: 2.5;
    stroke-linejoin: round;
  }

  .bioma.pmp {
    --tom: color-mix(in srgb, var(--cor-ink) 32%, var(--cor));
  }

  .bioma.ptn {
    --tom: color-mix(in srgb, var(--cor-ink) 40%, var(--cor));
  }

  .ponto {
    fill: var(--cor-ink);
    stroke: none;
    opacity: 0.6;
  }

  @media (max-width: 820px) {
    .bloco-disc {
      grid-column: span 1;
      min-height: 190px;
      padding: 22px;
    }
    .bloco-disc:not(.grande) h3 {
      font-size: 21px;
    }
    .grande {
      grid-column: span 2;
      min-height: 300px;
    }
    /* O último bloco pequeno, se sobrar sozinho, ocupa a linha inteira. */
    .bloco-disc:not(.grande):last-child:nth-child(odd) {
      grid-column: span 2;
    }
  }
</style>
