---
// Os três efeitos de uma força: começar a se mover, mudar de direção e deformar.
// Usar dentro de <Ilustracao>, que fornece as classes il-*.
---

<svg
  viewBox="0 0 900 270"
  role="img"
  aria-label="Três efeitos de uma força: um pé chuta uma bola parada, que começa a se mover; uma raquete desvia a direção de uma bola; uma mão aperta uma esponja, que se deforma"
>
  <rect width="900" height="270" rx="18" class="il-fundo"></rect>

  <!-- Começar a se mover -->
  <g transform="translate(150 0)">
    <rect x="-120" y="196" width="240" height="8" rx="4" class="chao"></rect>
    <path d="M-96 150c8-20 30-26 46-18l20 12c6 4 6 14-2 18l-44 20c-12 6-26-2-24-16z" class="pe"></path>
    <rect x="-104" y="96" width="22" height="58" rx="10" class="perna"></rect>
    <circle cx="10" cy="172" r="24" class="bola"></circle>
    <path d="M-2 160l12-6 12 6-4 14h-16z" class="bola-det"></path>
    <g class="il-seta"><path d="M42 172H96"></path><path d="M86 163l14 9-14 9z"></path></g>
    <path d="M-30 186h-20M-34 176h-12" class="mov"></path>
    <text x="0" y="238" text-anchor="middle" class="il-rot">Começar a se mover</text>
  </g>

  <!-- Mudar de direção -->
  <g transform="translate(450 0)">
    <path d="M-100 70Q-20 90 4 140" class="traj"></path>
    <path d="M4 140Q30 110 96 96" class="traj2"></path>
    <ellipse cx="22" cy="152" rx="20" ry="28" transform="rotate(-35 22 152)" class="raquete"></ellipse>
    <rect x="34" y="170" width="8" height="44" rx="4" transform="rotate(-35 38 192)" class="cabo"></rect>
    <circle cx="4" cy="136" r="12" class="tenis"></circle>
    <g class="il-seta"><path d="M60 102L92 95"></path><path d="M82 88l14 7-12 11z"></path></g>
    <text x="0" y="238" text-anchor="middle" class="il-rot">Mudar de direção</text>
  </g>

  <!-- Deformar -->
  <g transform="translate(750 0)">
    <rect x="-80" y="196" width="160" height="8" rx="4" class="chao"></rect>
    <path d="M-62 196V160Q-62 150-52 150Q-26 166 0 166Q26 166 52 150Q62 150 62 160V196z" class="esponja"></path>
    <circle cx="-30" cy="180" r="4" class="furo"></circle>
    <circle cx="-6" cy="186" r="3" class="furo"></circle>
    <circle cx="22" cy="178" r="4" class="furo"></circle>
    <circle cx="40" cy="188" r="3" class="furo"></circle>
    <path d="M-26 96h52a8 8 0 0 1 8 8v40h-68v-40a8 8 0 0 1 8-8z" class="mao"></path>
    <g class="il-seta"><path d="M0 66V92"></path><path d="M-9 82l9 14 9-14z"></path></g>
    <text x="0" y="238" text-anchor="middle" class="il-rot">Deformar</text>
  </g>
</svg>

<style>
  .il-rot {
    font-size: 16px;
  }
  .chao {
    fill: var(--gelo-linha);
  }
  .pe {
    fill: #2f3a4a;
  }
  .perna {
    fill: #3c6fb0;
  }
  .bola {
    fill: #ffffff;
    stroke: #2f3a4a;
    stroke-width: 3;
  }
  .bola-det {
    fill: #2f3a4a;
  }
  .mov {
    stroke: var(--muted);
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0.5;
  }
  .traj,
  .traj2 {
    fill: none;
    stroke: var(--muted);
    stroke-width: 3;
    stroke-dasharray: 3 7;
    stroke-linecap: round;
  }
  .traj2 {
    stroke: var(--ink);
    stroke-dasharray: none;
    opacity: 0.6;
  }
  .raquete {
    fill: #e2a93b;
    stroke: #b8804a;
    stroke-width: 4;
  }
  .cabo {
    fill: #8b5e34;
  }
  .tenis {
    fill: #c9e24a;
    stroke: #9fb52e;
    stroke-width: 2;
  }
  .esponja {
    fill: #ffc94d;
    stroke: #e0a830;
    stroke-width: 3;
  }
  .furo {
    fill: #e0a830;
  }
  .mao {
    fill: #f1c7a3;
  }
</style>
