---
// Página de Conteúdos. Cada filtro é uma página estática própria
// (/conteudos/ e /conteudos/<disciplina>/), então funciona sem JavaScript
// e cada disciplina tem um link para compartilhar.
import Base from '../layouts/Base.astro';
import Etiquetas from './Etiquetas.astro';
import { disciplinas, modulos, roteiro, rota, temPagina, type Disciplina, type Modulo } from '../lib/catalogo';
import { url } from '../lib/url';
import { SITE } from '../site';

interface Props {
  /** Id da disciplina filtrada. Sem ele, mostra todas. */
  filtro?: string;
}

const { filtro } = Astro.props;
const todas = await disciplinas();

/** total: lições com página; breve: lições “em breve”. */
type Grupo = { disciplina: Disciplina; itens: { modulo: Modulo; total: number; breve: number }[] };
const grupos: Grupo[] = [];
for (const disciplina of todas) {
  const itens = await Promise.all(
    (await modulos(disciplina.id)).map(async (modulo) => {
      const lista = await roteiro(modulo.id);
      const total = lista.filter(temPagina).length;
      return { modulo, total, breve: lista.length - total };
    }),
  );
  // Módulos publicados primeiro, mantendo a ordem do catálogo dentro de cada grupo.
  itens.sort((a, b) => Number(b.total > 0) - Number(a.total > 0));
  grupos.push({ disciplina, itens });
}

const filtros = [
  { id: undefined, nome: 'Todas', cor: undefined, href: url('conteudos/'), n: grupos.reduce((s, g) => s + g.itens.length, 0) },
  ...grupos.map(({ disciplina: d, itens }) => ({
    id: d.id,
    nome: d.data.nome,
    cor: d.data.cor,
    href: url(`conteudos/${d.id}/`),
    n: itens.length,
  })),
];

// Em “Todas”, só aparecem disciplinas que já têm módulos.
const visiveis = filtro ? grupos.filter((g) => g.disciplina.id === filtro) : grupos.filter((g) => g.itens.length);
const atual = filtro ? todas.find((d) => d.id === filtro) : undefined;
---

<Base
  titulo={atual ? `${atual.data.nome} · Conteúdos` : 'Conteúdos'}
  descricao={atual ? `Lições de ${atual.data.nome}: ${atual.data.resumo.toLowerCase()}` : undefined}
>
  <section class="conteudos">
    <h1>Conteúdos</h1>
    <p class="lede">Escolha uma disciplina ou veja tudo de uma vez.</p>

    <nav class="filtros" aria-label="Filtrar por disciplina">
      {
        filtros.map((f) => (
          <a href={f.href} aria-current={f.id === filtro ? 'page' : undefined}>
            {f.cor && <i style={`background: var(--${f.cor}-ink)`} />}
            {f.nome}
            <small>{f.n}</small>
          </a>
        ))
      }
    </nav>

    {
      visiveis.map(({ disciplina: d, itens }) => (
        <section class="grupo" aria-labelledby={`g-${d.id}`}>
          <h2 id={`g-${d.id}`} class:list={{ 'sr-only': filtro }}>
            <i style={`background: var(--${d.data.cor}-ink)`} />
            {d.data.nome}
          </h2>
          {itens.length ? (
            <ul class="lista" data-revelar="filhos">
              {itens.map(({ modulo: m, total, breve }) => (
                <li class:list={{ breve: !total }}>
                  <i style={`background: var(--${d.data.cor}-ink)`} />
                  {total ? (
                    <a class="tit link-linha" href={rota(m)}>
                      {m.data.titulo}
                    </a>
                  ) : (
                    <span class="tit">{m.data.titulo}</span>
                  )}
                  <span class="meta">
                    {total ? <span class="ok">{total === 1 ? '1 lição' : `${total} lições`}</span> : 'Em breve'}
                    {total > 0 && breve > 0 && ` · ${breve} em breve`}
                    {!total && breve > 0 && ` · ${breve === 1 ? '1 lição' : `${breve} lições`}`}
                  </span>
                  <span class="desc">{m.data.descricao}</span>
                  <Etiquetas modulo={m} rotulo="Antes:" class="pre-item" />
                </li>
              ))}
            </ul>
          ) : (
            <div class="vazio prosa">
              <p>{d.data.nome} ainda não tem módulos publicados.</p>
              <p>
                Os conteúdos novos são anunciados no{' '}
                <a href={SITE.github} target="_blank" rel="noopener">
                  GitHub do projeto
                </a>
                .
              </p>
            </div>
          )}
        </section>
      ))
    }
  </section>
</Base>

<style>
  .conteudos {
    max-width: 900px;
    margin: 0 auto;
    padding: 56px 24px 100px;
  }

  h1 {
    margin: 0 0 12px;
    font-weight: 500;
    font-size: clamp(36px, 5vw, 52px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .lede {
    margin: 0 0 28px;
    color: var(--muted);
  }

  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 36px;
    font-family: var(--sans);
  }

  .filtros a {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 9px 16px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 15px;
    line-height: 1.2;
    text-decoration: none;
    transition:
      background var(--rapido),
      color var(--rapido),
      box-shadow var(--rapido),
      transform var(--rapido) var(--curva);
  }

  .filtros a:hover {
    background: var(--surface);
  }

  .filtros a:active {
    transform: scale(0.96);
  }

  .filtros a[aria-current='page'] {
    background: var(--ink);
    color: var(--bg);
    box-shadow: none;
  }

  .filtros i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .filtros small {
    opacity: 0.6;
    font-size: inherit;
    font-variant-numeric: tabular-nums;
  }

  .grupo {
    margin-bottom: 44px;
  }

  .grupo h2 {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 10px;
    font-weight: 500;
    font-size: 26px;
  }

  .grupo h2 i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .lista {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .lista li {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr) auto;
    gap: 4px 16px;
    align-items: baseline;
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }

  .lista li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .lista li > i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    transform: translateY(-2px);
  }

  .tit {
    font-size: 21px;
    font-weight: 500;
  }


  .breve .tit {
    color: var(--muted);
  }

  .meta {
    font-family: var(--sans);
    font-size: 14px;
    color: var(--muted);
    text-align: right;
    white-space: nowrap;
  }

  .meta .ok {
    color: var(--ink);
    font-weight: 500;
  }

  .desc {
    grid-column: 2;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.5;
  }

  .lista :global(.pre-item) {
    grid-column: 2 / -1;
    margin-top: 8px;
  }

  .vazio {
    padding: 28px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }

  .vazio p {
    margin: 0 0 6px;
  }

  @media (max-width: 820px) {
    .lista li {
      grid-template-columns: 14px minmax(0, 1fr);
    }
    .meta {
      grid-column: 2;
      text-align: left;
    }
  }
</style>
