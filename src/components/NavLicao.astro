---
// Fim de cada lição: “Lição 2 de 11” com barra de progresso e os cartões
// anterior/próxima. Nas pontas, os cartões levam de volta ao módulo.
import { navegacao, rota, type Licao, type Modulo } from '../lib/catalogo';

interface Props {
  licao: Licao;
  modulo: Modulo;
}

const { licao, modulo } = Astro.props;
const { posicao, total, anterior, proxima } = await navegacao(licao);
const progresso = `${(posicao / total) * 100}%`;
---

<nav class="nav-licao" aria-label="Navegação entre lições">
  <div class="prog" data-revelar>
    <span>Lição {posicao} de {total} · <a href={rota(modulo)} class="link-linha">{modulo.data.titulo}</a></span>
    <span class="barra" role="progressbar" aria-label="Progresso no módulo" aria-valuemin="1" aria-valuemax={total} aria-valuenow={posicao}>
      <i style={`width: ${progresso}`}></i>
    </span>
  </div>
  <div class="par">
    <a class="ant" href={anterior ? rota(anterior) : rota(modulo)} rel={anterior ? 'prev' : undefined}>
      <small><span class="seta" aria-hidden="true">←</span> {anterior ? 'Anterior' : 'Início do módulo'}</small>
      <b>{anterior ? anterior.data.titulo : modulo.data.titulo}</b>
    </a>
    <a class="prox" href={proxima ? rota(proxima) : rota(modulo)} rel={proxima ? 'next' : undefined}>
      <small>{proxima ? 'Próxima' : 'Fim do módulo'} <span class="seta" aria-hidden="true">→</span></small>
      <b>{proxima ? proxima.data.titulo : modulo.data.titulo}</b>
    </a>
  </div>
</nav>

<style>
  .nav-licao {
    margin-top: 64px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
    font-family: var(--sans);
  }

  .prog {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin-bottom: 18px;
    font-size: 14px;
    color: var(--muted);
  }

  .prog a {
    color: inherit;
  }

  .barra {
    flex: 1 1 120px;
    height: 4px;
    border-radius: 2px;
    background: var(--line);
    overflow: hidden;
  }

  .barra i {
    display: block;
    transform-origin: left;
    transition: transform 1s var(--curva) 0.25s;
    height: 100%;
    border-radius: 2px;
    background: var(--cor-ink, var(--ink));
  }

  .par {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .par a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-height: 84px;
    padding: 16px 18px;
    border-radius: 16px;
    background: var(--surface);
    text-decoration: none;
    transition:
      background var(--rapido),
      transform var(--rapido) var(--curva);
  }

  .par a:hover {
    background: color-mix(in srgb, var(--surface) 70%, var(--line));
  }

  .par a:active {
    transform: scale(0.99);
  }

  .seta {
    display: inline-block;
    transition: transform var(--medio) var(--curva);
  }

  .ant:hover .seta {
    transform: translateX(-4px);
  }

  .prox:hover .seta {
    transform: translateX(4px);
  }

  /* A barra se preenche quando a navegação aparece na tela */
  :global(.revelar-ativo) .prog:not(.revelado) .barra i {
    transform: scaleX(0);
  }

  .prox {
    align-items: flex-end;
    text-align: right;
  }

  small {
    font-size: 13px;
    color: var(--muted);
  }

  b {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 19px;
    line-height: 1.3;
  }

  @media (max-width: 820px) {
    .par {
      grid-template-columns: 1fr;
    }
    .prox {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
