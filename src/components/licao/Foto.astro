---
// Uma foto da galeria. Sem `src`, mostra um espaço reservado descrevendo
// a imagem que deve ir ali (`previsto`).
//   import vitoria from './img/vitoria-regia.jpg';
//   <Foto src={vitoria} alt="…" titulo="Vitória-régia" legenda="…" credito="Fulano, CC BY-SA 4.0" />
//   <Foto titulo="Ipê-amarelo" previsto="Ipê florido no Cerrado, na seca" />
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  src?: ImageMetadata;
  /** Descrição para leitores de tela. Sem ela, usa o título. */
  alt?: string;
  titulo: string;
  legenda?: string;
  /** Autor e licença. Obrigatório para fotos de terceiros, como as do Wikimedia Commons. */
  credito?: string;
  previsto?: string;
}

const { src, alt, titulo, legenda, credito, previsto } = Astro.props;
const grande = src ? await getImage({ src, width: Math.min(1600, src.width), format: 'webp' }) : undefined;
const legendaCompleta = [titulo, legenda, credito].filter(Boolean).join(' · ');
---

<figure class="foto">
  {
    src && grande ? (
      <a class="foto-link" href={grande.src} data-legenda={legendaCompleta} aria-label={`Ampliar: ${titulo}`}>
        <Image
          src={src}
          alt={alt ?? titulo}
          widths={[400, 800]}
          sizes="(max-width: 820px) 100vw, 360px"
          format="webp"
          class="foto-img"
        />
      </a>
    ) : (
      <div class="foto-img foto-vazia" role="img" aria-label={`Imagem prevista: ${previsto ?? titulo}`}>
        <svg viewBox="0 0 64 40" aria-hidden="true">
          <path d="M4 36 22 14l12 14 8-8 18 16z" />
          <circle cx="48" cy="10" r="5" />
        </svg>
        <span>{previsto ?? 'Imagem prevista'}</span>
      </div>
    )
  }
  <figcaption>
    <b>{titulo}</b>
    {legenda}
    {credito && <span class="credito">{credito}</span>}
  </figcaption>
</figure>

<style>
  .foto {
    margin: 0;
  }

  .foto-link {
    display: block;
    border-radius: 16px;
    cursor: zoom-in;
  }

  .foto-img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 16px;
    object-fit: cover;
    /* Cor da região ou da disciplina, suavizada com o fundo para o texto ter contraste */
    background: color-mix(in srgb, var(--cor, var(--surface)) 45%, var(--bg));
    transition: transform 0.4s;
  }

  .foto-link:hover .foto-img {
    transform: scale(1.02);
  }

  .foto-vazia {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 16px;
    color: var(--cor-ink, var(--muted));
    font-family: var(--sans);
    font-size: 14px;
    text-align: center;
  }

  .foto-vazia svg {
    width: 64px;
    height: 40px;
    fill: currentColor;
    opacity: 0.35;
  }

  figcaption {
    padding: 12px 2px 0;
    font-size: 17px;
    line-height: 1.5;
  }

  figcaption b {
    display: block;
    margin-bottom: 2px;
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 600;
    color: var(--cor-ink, var(--ink));
  }

  .credito {
    display: block;
    margin-top: 4px;
    font-family: var(--sans);
    font-size: 13px;
    color: var(--muted);
  }
</style>
