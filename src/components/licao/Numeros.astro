---
// Quadro de números em destaque, por exemplo as espécies conhecidas num bioma.
//   <Numeros titulo="Espécies conhecidas" fonte="IBGE Educa"
//            itens={[[13229, 'plantas'], [1000, 'aves'], [3000, 'peixes']]} />
interface Props {
  titulo?: string;
  itens: [number, string][];
  fonte?: string;
}

const { titulo, itens, fonte } = Astro.props;
---

<section class="numeros" aria-label={titulo}>
  {titulo && <h3>{titulo}</h3>}
  <ul>
    {
      itens.map(([n, rotulo]) => (
        <li>
          <b>{n.toLocaleString('pt-BR')}</b>
          <span>{rotulo}</span>
        </li>
      ))
    }
  </ul>
  {fonte && <p class="fonte">Fonte: {fonte}</p>}
</section>

<style>
  .numeros {
    max-width: 560px;
    margin: 28px auto 0;
  }

  h3 {
    margin: 0 0 12px;
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 600;
    color: var(--muted);
    text-align: center;
  }

  ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    border-radius: 16px;
    overflow: hidden;
  }

  li {
    padding: 14px 10px 12px;
    background: var(--surface);
    text-align: center;
  }

  b {
    display: block;
    font-family: var(--serif);
    font-weight: 500;
    font-size: 28px;
    line-height: 1.1;
    font-variant-numeric: lining-nums;
    color: var(--cor-ink, var(--ink));
  }

  span {
    font-family: var(--sans);
    font-size: 14px;
    color: var(--muted);
  }

  .fonte {
    margin: 10px 0 0;
    font-family: var(--sans);
    font-size: 13px;
    color: var(--muted);
    text-align: center;
  }
</style>
