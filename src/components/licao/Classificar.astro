---
// Atividade de classificar: cada item recebe uma categoria, com retorno na hora
// e o placar no fim.
//   <Classificar
//     titulo="Classifique as forças"
//     instrucao="Para cada situação, escolha se a força é de contato ou à distância."
//     categorias={{ contato: 'Contato', distancia: 'À distância' }}
//     dicas={{ contato: 'Esta força só existe enquanto os corpos se tocam.' }}
//     itens={[
//       { texto: 'Uma pessoa empurrando um carrinho', categoria: 'contato' },
//       { texto: 'Um ímã puxando um clipe', categoria: 'distancia' },
//     ]}
//   />
// `dicas` é opcional: o texto mostrado quando a pessoa erra um item daquela categoria.
import '../../styles/atividade.css';

interface Props {
  titulo: string;
  instrucao?: string;
  categorias: Record<string, string>;
  dicas?: Record<string, string>;
  itens: { texto: string; categoria: string }[];
}

const { titulo, instrucao, categorias, dicas = {}, itens } = Astro.props;
for (const item of itens) {
  if (!(item.categoria in categorias)) {
    throw new Error(`Classificar: o item "${item.texto}" usa a categoria "${item.categoria}", que não está em "categorias".`);
  }
}
---

<section class="atividade classificar" aria-label={`Atividade: ${titulo}`}>
  <h3>{titulo}</h3>
  {instrucao && <p class="instrucao">{instrucao}</p>}
  <ul>
    {
      itens.map(({ texto, categoria }) => (
        <li data-certa={categoria} data-dica={dicas[categoria] ?? `É ${categorias[categoria].toLowerCase()}.`}>
          <span>{texto}</span>
          <div role="group" aria-label="Categoria">
            {Object.entries(categorias).map(([id, rotulo]) => (
              <button type="button" data-categoria={id}>
                {rotulo}
              </button>
            ))}
          </div>
          <p class="fb" aria-live="polite" />
        </li>
      ))
    }
  </ul>
  <p class="placar" aria-live="polite"></p>
</section>

<style>
  .instrucao {
    color: var(--muted);
  }

  ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px 14px;
    align-items: center;
    padding: 12px 14px;
    border-radius: 14px;
    background: var(--bg);
  }

  li > div {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  li button:not(.certo):not(.errado) {
    background: var(--surface);
  }

  .fb {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }

  .fb:empty,
  .placar:empty {
    display: none;
  }

  .placar {
    margin: 12px 0 0;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    li {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  for (const atividade of document.querySelectorAll<HTMLElement>('.classificar')) {
    const itens = [...atividade.querySelectorAll<HTMLLIElement>('li')];
    const placar = atividade.querySelector<HTMLElement>('.placar')!;
    let feitos = 0;
    let certos = 0;

    for (const item of itens) {
      const botoes = [...item.querySelectorAll<HTMLButtonElement>('button')];
      for (const botao of botoes) {
        botao.addEventListener('click', () => {
          const acertou = botao.dataset.categoria === item.dataset.certa;
          for (const b of botoes) {
            b.disabled = true;
            if (b.dataset.categoria === item.dataset.certa) b.classList.add('certo');
          }
          if (!acertou) botao.classList.add('errado');
          item.querySelector('.fb')!.textContent = acertou ? 'Certo.' : (item.dataset.dica ?? '');

          feitos++;
          if (acertou) certos++;
          if (feitos === itens.length) placar.textContent = `Você acertou ${certos} de ${itens.length}.`;
        });
      }
    }
  }
</script>
