---
// Matemática no meio do texto: <Tex tex="v = \frac{d}{t}" />.
// Para uma fórmula em destaque, com legenda, use <Formula />.
import katex from 'katex';
import 'katex/dist/katex.min.css';

interface Props {
  tex: string;
}

const html = katex.renderToString(Astro.props.tex, { throwOnError: true, output: 'htmlAndMathml' });
---

<span class="tex" set:html={html} />

<style>
  .tex :global(.katex) {
    font-size: 1.05em;
  }
</style>
