---
import BotaoTema from './BotaoTema.astro';
import { url } from '../lib/url';
import { SITE } from '../site';

const links = [
  { href: url('conteudos/'), rotulo: 'Conteúdos' },
  { href: url('sobre/'), rotulo: 'Sobre' },
];

const atual = Astro.url.pathname;
---

<header class="topo">
  <div class="topo-in">
    <a class="marca" href={url('/')} aria-label="Prometheus, página inicial">Prometheus</a>
    <nav aria-label="Principal">
      {
        links.map(({ href, rotulo }) => (
          <a href={href} aria-current={atual.startsWith(href) ? 'page' : undefined}>
            {rotulo}
          </a>
        ))
      }
      <a href={SITE.github} target="_blank" rel="noopener" class="ico" aria-label="Código no GitHub (abre em nova aba)">
        <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true">
          <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
      </a>
      <BotaoTema />
    </nav>
  </div>
</header>

<style>
  .topo {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 5;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .topo-in {
    max-width: 1200px;
    height: 56px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    gap: 28px;
    font-family: var(--sans);
    font-size: 15px;
  }

  .marca {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 22px;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 18px;
    margin-left: auto;
    align-items: center;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }

  /* Botões de ícone (GitHub e tema) */
  .topo :global(.ico) {
    all: unset;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: var(--muted);
  }

  .topo :global(.ico:hover) {
    color: var(--ink);
    background: var(--surface);
  }

  .topo :global(.ico:focus-visible) {
    outline: 2px solid var(--vel);
    outline-offset: 2px;
  }

  @media (max-width: 820px) {
    .topo-in {
      gap: 14px;
      padding: 0 18px;
    }
    nav {
      gap: 6px;
    }
  }
</style>
