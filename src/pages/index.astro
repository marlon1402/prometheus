---
import Base from '../layouts/Base.astro';
---

<Base>
  <!-- Provisório: a Home completa entra no Passo 4. -->
  <section class="hero">
    <h1>Entenda como o mundo funciona.</h1>
    <p class="lede">Ciência explicada com simulações interativas.</p>
  </section>
</Base>

<style>
  .hero {
    max-width: var(--page);
    margin: 0 auto;
    padding: 88px 32px 72px;
  }

  h1 {
    max-width: 12ch;
    margin: 0 0 28px;
    font-weight: 500;
    font-size: clamp(46px, 7vw, 92px);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  .lede {
    max-width: 33ch;
    margin: 0;
    color: var(--muted);
    font-size: 22px;
    line-height: 1.55;
  }

  @media (max-width: 820px) {
    .hero {
      padding: 48px 20px 24px;
    }
  }
</style>
