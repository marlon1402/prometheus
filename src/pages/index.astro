---
// Home. Os textos são gerais e não citam lições específicas, para não
// precisarem mudar a cada conteúdo novo.
import Base from '../layouts/Base.astro';
import BlocoDisciplina from '../components/BlocoDisciplina.astro';
import AnimacaoAbertura from '../sims/fisica/canhao-newton/AnimacaoAbertura.astro';
import { disciplinas } from '../lib/catalogo';
import { url } from '../lib/url';

// As duas primeiras disciplinas (as de lançamento) aparecem em blocos grandes.
const lista = await disciplinas();
---

<Base>
  <section class="hero">
    <div>
      <h1>Entenda como o mundo funciona.</h1>
      <p class="lede">Ciência explicada com simulações interativas.</p>
      <div class="cta">
        <a class="btn" href={url('conteudos/')}>Explorar conteúdos</a>
        <span class="selo">Gratuito e sem cadastro</span>
      </div>
    </div>
    <AnimacaoAbertura />
  </section>

  <section class="manifesto">
    <p>Forças invisíveis, processos lentos, lugares distantes. Tudo isso, diante dos seus olhos.</p>
  </section>

  <section class="bloco" aria-labelledby="h-como">
    <h2 id="h-como">Como você aprende aqui</h2>
    <ol class="passos">
      <li>
        <svg viewBox="0 0 120 80" aria-hidden="true">
          <rect x="14" y="16" width="80" height="6" rx="3"></rect>
          <rect x="14" y="30" width="92" height="6" rx="3"></rect>
          <rect x="14" y="44" width="70" height="6" rx="3"></rect>
          <rect x="14" y="58" width="50" height="6" rx="3"></rect>
        </svg>
        <h3>Entenda</h3>
        <p>Explicações claras e diretas.</p>
      </li>
      <li>
        <svg viewBox="0 0 120 80" aria-hidden="true">
          <path d="M14 58 Q 60 -6 106 58" fill="none" stroke-width="4" stroke-linecap="round"></path>
          <rect x="14" y="68" width="92" height="4" rx="2" opacity=".35"></rect>
          <circle cx="62" cy="70" r="7"></circle>
        </svg>
        <h3>Teste</h3>
        <p>Mude um valor e veja o resultado.</p>
      </li>
      <li>
        <svg viewBox="0 0 120 80" aria-hidden="true">
          <rect x="18" y="52" width="22" height="18" rx="3"></rect>
          <rect x="49" y="36" width="22" height="34" rx="3"></rect>
          <rect x="80" y="16" width="22" height="54" rx="3"></rect>
        </svg>
        <h3>Aprofunde</h3>
        <p>Do básico ao ensino médio.</p>
      </li>
    </ol>
  </section>

  <section class="bloco" aria-labelledby="h-disc">
    <div class="bloco-cab">
      <h2 id="h-disc">Várias ciências, um só jeito de aprender</h2>
      <a class="mais" href={url('conteudos/')}>Ver todos os conteúdos</a>
    </div>
    <div class="disciplinas">
      {lista.map((d, i) => <BlocoDisciplina disciplina={d} grande={i < 2} />)}
    </div>
  </section>

  <section class="bloco" aria-labelledby="h-quem">
    <h2 id="h-quem">Para quem é</h2>
    <div class="publicos">
      <div>
        <h3>Estudantes</h3>
        <p>Para entender, não só decorar.</p>
      </div>
      <div>
        <h3>Professores</h3>
        <p>Para projetar em sala ou indicar à turma.</p>
      </div>
      <div>
        <h3>Curiosos</h3>
        <p>Pelo prazer de entender o mundo.</p>
      </div>
    </div>
  </section>

  <section class="faixa" aria-labelledby="h-faixa">
    <div class="faixa-in">
      <h2 id="h-faixa">Conhecimento é para ser compartilhado.</h2>
      <p class="faixa-txt">Como o fogo de Prometeu, para todos.</p>
      <ul>
        <li>Gratuito</li>
        <li>Sem cadastro</li>
        <li>Sem anúncios</li>
        <li>Sem coleta de dados</li>
      </ul>
      <div class="cta">
        <a class="btn claro" href={url('conteudos/')}>Explorar conteúdos</a>
        <a class="btn contorno" href={url('sobre/')}>Conhecer o projeto</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
    max-width: var(--page);
    margin: 0 auto;
    padding: 88px 32px 72px;
  }

  h1 {
    margin: 0 0 28px;
    font-weight: 500;
    font-size: clamp(46px, 7vw, 92px);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  .lede {
    max-width: 33ch;
    margin: 0;
    color: var(--muted);
    font-size: 22px;
    line-height: 1.55;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
    margin-top: 40px;
    font-family: var(--sans);
  }

  .selo {
    font-size: 15px;
    color: var(--muted);
  }

  .manifesto {
    max-width: var(--page);
    margin: 0 auto;
    padding: 72px 32px 96px;
  }

  .manifesto p {
    max-width: 28ch;
    margin: 0;
    font-weight: 400;
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .bloco {
    max-width: var(--page);
    margin: 0 auto;
    padding: 80px 32px;
  }

  .bloco h2,
  .faixa h2 {
    margin: 0 0 40px;
    font-weight: 500;
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .bloco-cab {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
  }

  .mais {
    font-family: var(--sans);
    font-size: 16px;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }

  /* Como você aprende aqui */
  .passos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: passo;
  }

  .passos li {
    counter-increment: passo;
    padding: 28px 28px 32px;
    border-radius: 20px;
    background: var(--surface);
  }

  .passos svg {
    display: block;
    width: 120px;
    height: 80px;
    margin-bottom: 28px;
    fill: var(--fis-ink);
    stroke: var(--fis-ink);
  }

  .passos svg rect {
    fill: currentColor;
    stroke: none;
    color: var(--line);
  }

  .passos li:nth-child(1) svg rect {
    color: var(--fis-ink);
    opacity: 0.4;
  }

  .passos li:nth-child(1) svg rect:first-child {
    opacity: 0.75;
  }

  .passos li:nth-child(2) svg circle {
    fill: var(--bg);
    stroke: var(--fis-ink);
    stroke-width: 3;
  }

  .passos li:nth-child(3) svg rect {
    color: var(--fis-ink);
  }

  .passos li:nth-child(3) svg rect:nth-child(1) {
    opacity: 0.35;
  }

  .passos li:nth-child(3) svg rect:nth-child(2) {
    opacity: 0.65;
  }

  .passos h3 {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 8px;
    font-family: var(--sans);
    font-weight: 600;
    font-size: 20px;
  }

  .passos h3::before {
    content: counter(passo);
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
  }

  .passos p {
    margin: 0;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.55;
  }

  /* Disciplinas */
  .disciplinas {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 16px;
  }

  /* Para quem é */
  .publicos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px;
  }

  .publicos > div {
    padding-top: 20px;
    border-top: 2px solid var(--ink);
  }

  .publicos h3 {
    margin: 0 0 10px;
    font-family: var(--sans);
    font-weight: 600;
    font-size: 18px;
  }

  .publicos p {
    margin: 0;
    color: var(--muted);
    font-size: 19px;
    line-height: 1.55;
  }

  /* Faixa final */
  .faixa {
    padding: 24px 32px 32px;
  }

  .faixa-in {
    max-width: var(--page);
    margin: 0 auto;
    padding: 80px 64px;
    border-radius: 32px;
    background: var(--faixa);
    color: var(--faixa-txt);
  }

  .faixa h2 {
    max-width: 16ch;
    margin-bottom: 16px;
  }

  .faixa-txt {
    max-width: 52ch;
    margin: 0 0 44px;
    font-size: 20px;
    line-height: 1.55;
    color: color-mix(in srgb, var(--faixa-txt) 75%, transparent);
  }

  .faixa ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--sans);
    font-weight: 600;
    font-size: 17px;
  }

  .faixa .cta {
    margin-top: 56px;
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 48px 20px 24px;
    }
    .hero :global(.abertura) {
      justify-self: center;
      width: 100%;
      max-width: 420px;
    }
    .manifesto {
      padding: 48px 20px 56px;
    }
    .bloco {
      padding: 56px 20px;
    }
    .passos,
    .publicos {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .publicos {
      gap: 32px;
    }
    .disciplinas {
      grid-template-columns: 1fr 1fr;
    }
    .faixa {
      padding: 8px 12px 20px;
    }
    .faixa-in {
      padding: 52px 26px;
      border-radius: 24px;
    }
    .faixa ul {
      grid-template-columns: 1fr 1fr;
      gap: 22px;
    }
  }
</style>
