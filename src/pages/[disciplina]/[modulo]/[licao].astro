---
import { render } from 'astro:content';
import Licao from '../../../layouts/Licao.astro';
import { componentesDaLicao } from '../../../components/licao';
import { fontesDa, licoes } from '../../../lib/catalogo';

export async function getStaticPaths() {
  return (await licoes()).map((licao) => {
    const [disciplina, modulo, slug] = licao.id.split('/');
    return { params: { disciplina, modulo, licao: slug }, props: { licao } };
  });
}

const { licao } = Astro.props;
const fontes = await fontesDa(licao);
// <Ref> numera as chamadas pela posição nesta lista, lida durante a renderização do texto.
Astro.locals.referencias = fontes.referencias.map((f) => f.id);
const { Content, headings } = await render(licao);
---

<Licao licao={licao} headings={headings} fontes={fontes}>
  <Content components={componentesDaLicao} />
</Licao>
