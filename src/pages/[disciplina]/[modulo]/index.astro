---
// Página de abertura de um módulo: gancho, pré-requisitos e o caminho completo.
// Só módulos com lições publicadas ganham página. As lições “em breve”
// aparecem na lista, na posição delas, mas sem link.
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Etiquetas from '../../../components/Etiquetas.astro';
import Trilha from '../../../components/Trilha.astro';
import { disciplinaDe, licoes, modulos, NIVEIS, publicado, roteiro, rota, temPagina, type Modulo } from '../../../lib/catalogo';

export async function getStaticPaths() {
  const lista: Modulo[] = [];
  for (const m of await modulos()) if (await publicado(m)) lista.push(m);
  return lista.map((modulo) => {
    const [disciplina, slug] = modulo.id.split('/');
    return { params: { disciplina, modulo: slug }, props: { modulo } };
  });
}

const { modulo } = Astro.props;
const disciplina = await disciplinaDe(modulo);
const [prontas, lista] = await Promise.all([licoes(modulo.id), roteiro(modulo.id)]);
const faltam = lista.length - prontas.length;
const { Content } = await render(modulo);
const cor = disciplina.data.cor;
---

<Base titulo={modulo.data.titulo} descricao={modulo.data.descricao}>
  <article class="modulo leitura" style={`--cor: var(--${cor}); --cor-ink: var(--${cor}-ink)`}>
    <Trilha disciplina={disciplina} modulo={modulo} />
    <h1>{modulo.data.titulo}</h1>
    <p class="lede">{modulo.data.gancho ?? modulo.data.descricao}</p>
    <p class="meta">
      {prontas.length === 1 ? '1 lição' : `${prontas.length} lições`}
      {faltam > 0 && ` · ${faltam} em breve`}
    </p>
    <Etiquetas modulo={modulo} rotulo="Pré-requisitos" vazio="Nenhum: dá para começar por aqui." class="pre-modulo" />

    <div class="corpo prosa">
      <Content />
    </div>

    <ol class="lista" data-revelar="filhos">
      {
        lista.map((l) =>
          temPagina(l) ? (
            <li>
              <a class="tit link-linha" href={rota(l)}>
                {l.data.titulo}
              </a>
              <span class="desc">
                {l.data.descricao}{' '}
                <span class="nivel">
                  {NIVEIS[l.data.nivel]} · {l.data.duracao} min{l.data.rascunho && ' · rascunho'}
                </span>
              </span>
            </li>
          ) : (
            <li class="breve">
              <span class="tit">{l.data.titulo}</span>
              <span class="desc">
                {l.data.descricao && `${l.data.descricao} `}
                <span class="nivel">Em breve</span>
              </span>
            </li>
          ),
        )
      }
    </ol>

    <a class="btn link-seta" href={rota(prontas[0])}>Começar pela primeira lição</a>
  </article>
</Base>

<style>
  .modulo {
    padding: 56px 24px 120px;
  }

  h1 {
    margin: 0 0 20px;
    font-weight: 500;
    font-size: clamp(36px, 5vw, 52px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .lede {
    margin: 0 0 12px;
    font-size: 23px;
    color: var(--muted);
  }

  .meta {
    margin: 0 0 16px;
    font-family: var(--sans);
    font-size: 15px;
    color: var(--muted);
  }

  .modulo :global(.pre-modulo) {
    margin-bottom: 32px;
  }

  .corpo :global(p) {
    margin: 0 0 22px;
  }

  .lista {
    list-style: none;
    margin: 8px 0 40px;
    padding: 0;
    counter-reset: l;
  }

  .lista li {
    counter-increment: l;
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 2px 16px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }

  .lista li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .lista li::before {
    content: counter(l);
    grid-row: span 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--cor-ink);
    color: var(--bg);
    font: 600 15px var(--sans);
  }

  .tit {
    font-size: 21px;
    font-weight: 500;
  }

  .breve .tit {
    color: var(--muted);
  }

  .lista .breve::before {
    background: none;
    box-shadow: inset 0 0 0 1.5px var(--line);
    color: var(--muted);
  }

  .desc {
    color: var(--muted);
    font-size: 17px;
    line-height: 1.5;
  }

  .nivel {
    font-family: var(--sans);
    font-size: 13px;
    white-space: nowrap;
  }
</style>
