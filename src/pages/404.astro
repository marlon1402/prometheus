---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base titulo="Página não encontrada">
  <section class="erro leitura">
    <p class="codigo">404</p>
    <h1>Esta página não existe.</h1>
    <p class="lede">Talvez o endereço tenha mudado, ou a lição ainda não foi publicada.</p>
    <a class="btn" href={url('conteudos/')}>Ver os conteúdos</a>
  </section>
</Base>

<style>
  .erro {
    padding: 96px 24px 120px;
  }

  .codigo {
    margin: 0 0 8px;
    font-family: var(--sans);
    font-size: 15px;
    color: var(--muted);
  }

  h1 {
    margin: 0 0 16px;
    font-weight: 500;
    font-size: clamp(36px, 5vw, 52px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .lede {
    margin: 0 0 36px;
    font-size: 22px;
    color: var(--muted);
  }
</style>
