---
// Layout das lições. O texto fica numa coluna estreita; elementos com a
// classe .largo (simulações, ilustrações, mapas) ocupam uma largura maior.
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import NavLicao from '../components/NavLicao.astro';
import Trilha from '../components/Trilha.astro';
import { disciplinaDe, moduloDe, type Licao } from '../lib/catalogo';

interface Props {
  licao: Licao;
  headings: MarkdownHeading[];
}

const { licao, headings } = Astro.props;
const [disciplina, modulo] = await Promise.all([disciplinaDe(licao), moduloDe(licao)]);
const partes = headings.filter((h) => h.depth === 2);
const cor = disciplina.data.cor;
---

<Base titulo={licao.data.titulo} descricao={licao.data.descricao} tipo="article">
  <article class="licao" style={`--cor: var(--${cor}); --cor-ink: var(--${cor}-ink)`}>
    <header class="leitura">
      <Trilha disciplina={disciplina} modulo={modulo} moduloComLink />
      <h1>{licao.data.titulo}</h1>
      <p class="lede">{licao.data.descricao}</p>
      {
        partes.length > 1 && (
          <nav class="indice" aria-label="Partes da lição">
            <span class="indice-marca" aria-hidden="true" />
            <ol>
              {partes.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </header>

    <div class="corpo prosa">
      <slot />
    </div>

    <footer class="leitura">
      <NavLicao licao={licao} modulo={modulo} />
    </footer>
  </article>
</Base>

<style>
  .licao {
    padding: 56px 24px 120px;
  }

  h1 {
    margin: 0 0 20px;
    font-weight: 500;
    font-size: clamp(36px, 5vw, 52px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .lede {
    margin: 0 0 36px;
    font-size: 23px;
    color: var(--muted);
  }

  .indice {
    position: relative;
    margin: 0 0 48px;
    padding: 4px 0 4px 18px;
    border-left: 2px solid var(--cor);
    font-family: var(--sans);
    font-size: 15px;
  }

  .indice ol {
    display: grid;
    gap: 4px;
    margin: 0;
    padding-left: 20px;
  }

  .indice a {
    color: var(--muted);
    text-decoration: none;
    transition: color var(--rapido);
  }

  .indice a:hover,
  .indice a[aria-current] {
    color: var(--ink);
  }

  /* Marcador que desliza pela borda até a parte que está sendo lida */
  .indice-marca {
    position: absolute;
    left: -2px;
    width: 2px;
    border-radius: 2px;
    background: var(--cor-ink);
    opacity: 0;
    transition:
      top var(--medio) var(--curva),
      height var(--medio) var(--curva),
      opacity var(--medio);
  }

  /* Corpo da lição (MDX) */
  .corpo {
    counter-reset: parte;
  }

  .corpo > :global(*) {
    max-width: var(--read);
    margin-inline: auto;
  }

  .corpo > :global(.largo) {
    max-width: var(--wide);
  }

  /* Para conteúdos que precisam da página inteira, como o mapa com camadas */
  .corpo > :global(.amplo) {
    max-width: 1380px;
  }

  .corpo > :global(p) {
    margin-block: 0 22px;
  }

  .corpo > :global(h2) {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-block: 64px 16px;
    font-weight: 500;
    font-size: 30px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  /* Numeração das partes, igual à do índice */
  .corpo > :global(h2)::before {
    counter-increment: parte;
    content: counter(parte);
    min-width: 1.4em;
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 600;
    color: var(--cor-ink);
  }

  .corpo > :global(h3) {
    margin-block: 40px 12px;
    font-family: var(--sans);
    font-weight: 600;
    font-size: 20px;
  }

  .corpo > :global(ul),
  .corpo > :global(ol) {
    display: grid;
    gap: 8px;
    margin-block: 0 22px;
    padding-left: 24px;
  }

  /* O número da parte pulsa ao chegar nela pelo índice */
  .corpo > :global(h2:target)::before {
    animation: destaque 0.9s var(--curva);
  }

  @keyframes destaque {
    0%,
    30% {
      transform: scale(1.7);
    }
  }

  @media (max-width: 820px) {
    .licao {
      padding: 40px 20px 96px;
    }
    .corpo > :global(h2) {
      font-size: 26px;
      margin-top: 52px;
    }
  }
</style>

<script>
  // Índice: destaca a parte que está sendo lida e move o marcador até ela.
  const indice = document.querySelector<HTMLElement>('.indice');
  if (indice) {
    const marca = indice.querySelector<HTMLElement>('.indice-marca')!;
    const links = [...indice.querySelectorAll<HTMLAnchorElement>('a')];
    const partes = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
    let atual = -1;

    const atualizar = () => {
      // A parte atual é a última cujo título já passou do topo (com folga para o cabeçalho).
      let i = -1;
      partes.forEach((p, j) => {
        if (p && p.getBoundingClientRect().top < innerHeight * 0.3) i = j;
      });
      if (i === atual) return;
      atual = i;
      links.forEach((a, j) => (j === i ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')));
      if (i < 0) {
        marca.style.opacity = '0';
        return;
      }
      const li = links[i].parentElement!;
      marca.style.top = `${li.offsetTop}px`;
      marca.style.height = `${li.offsetHeight}px`;
      marca.style.opacity = '1';
    };

    let agendado = false;
    addEventListener(
      'scroll',
      () => {
        if (agendado) return;
        agendado = true;
        requestAnimationFrame(() => {
          agendado = false;
          atualizar();
        });
      },
      { passive: true },
    );
    addEventListener('resize', () => {
      atual = -1;
      atualizar();
    });
    atualizar();
  }
</script>
